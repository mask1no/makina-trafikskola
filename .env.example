# Copy the values you use in production into `.env.railway` (git-ignored).
# Do not put production secrets in `.env.production.local`. Next.js loads that
# name automatically during local production builds.

# ─── App / Auth ─────────────────────────────────────────────────────
# Required. Session signing secret. Generate with `openssl rand -base64 32`.
AUTH_SECRET=
# Required. Canonical origin, no trailing slash. https://www.makina.se
AUTH_URL=
# Required. Same origin as AUTH_URL. Baked in at build time.
NEXT_PUBLIC_SITE_URL=
# Optional. Set to true behind Railway's proxy.
AUTH_TRUST_HOST=

# ─── Database ───────────────────────────────────────────────────────
# Required. Railway Postgres reference, or a local Postgres URL.
DATABASE_URL=

# ─── Stripe ─────────────────────────────────────────────────────────
# Required. Stripe → Developers → API keys → Secret key (or a restricted key).
STRIPE_SECRET_KEY=
# Required. Stripe → Developers → Webhooks → endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=
# Required for the browser. Stripe → Developers → API keys → Publishable key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Google sign-in ────────────────────────────────────────────────
# Optional. Google Cloud → APIs & Services → Credentials → OAuth client.
# Redirect URI: https://www.makina.se/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Google Maps ───────────────────────────────────────────────────
# Optional. Preferred browser key. Google Cloud → Credentials → API key,
# referrer-restricted to https://www.makina.se/*
GOOGLE_MAPS_BROWSER_KEY=
# Optional. Google Cloud → Map Management → Map ID (vector, Advanced Markers).
GOOGLE_MAPS_MAP_ID=
# Legacy fallback. Used only when GOOGLE_MAPS_BROWSER_KEY is empty.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Legacy fallback. Used only when GOOGLE_MAPS_MAP_ID is empty.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Optional. IP-restricted server key for geocoding only.
GOOGLE_MAPS_SERVER_KEY=

# ─── Google Calendar ───────────────────────────────────────────────
# Optional. 1 turns sync on. Both this and the service account must be set.
GOOGLE_CALENDAR_SYNC_ENABLED=0
# Optional. Base64 of the Workspace service-account JSON.
# Google Cloud → IAM → Service accounts → Keys → JSON, then base64-encode it.
# Share each teacher's calendar with the service-account email.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# ─── 46elks ─────────────────────────────────────────────────────────
# Required in production. 46elks → Dashboard → API username and password.
ELKS_API_USERNAME=
ELKS_API_PASSWORD=

# ─── Cloudflare R2 ──────────────────────────────────────────────────
# Optional. Instructor photos. Cloudflare → R2 → Manage API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket host, https://...
R2_PUBLIC_URL=
# Optional. Private bucket for pg_dump backups.
R2_BACKUP_BUCKET=
BACKUP_PREFIX=postgres
# Optional. Override the object key used by verify:restore.
BACKUP_OBJECT_KEY=

# ─── Sentry ─────────────────────────────────────────────────────────
# Optional. Sentry → Project → Client Keys (DSN).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Cron ───────────────────────────────────────────────────────────
# Required. Bearer token for POST /api/cron/core. openssl rand -base64 32.
CRON_SECRET=

# ─── Launch flags ───────────────────────────────────────────────────
# 1 shows public booking. 0 replaces it with a phone call.
BOOKING_ENABLED=0
# 1 shows instructor pages.
INSTRUCTORS_ENABLED=0
# off hides theory. free shows the free practice set. full also sells theory.
THEORY_MODE=free
CANCELLATION_WINDOW_HOURS=24
MIN_BOOKING_NOTICE_HOURS=12
BOOKING_HOLD_MINUTES=15
REVIEW_RATE_LIMIT=5
# Optional. Credit validity in days. Default 365.
CREDIT_VALIDITY_DAYS=365

# ─── App store + social links ───────────────────────────────────────
# Optional. Badges and icons render only when the URL is set.
APP_STORE_URL=
GOOGLE_PLAY_URL=
INSTAGRAM_URL=
FACEBOOK_URL=
TIKTOK_URL=

# ─── Local-only ─────────────────────────────────────────────────────
# Restore target for backup verification. Never set this on Railway.
RESTORE_DATABASE_URL=
# Path overrides for pg_dump and pg_restore on a developer machine.
PG_DUMP_BIN=
PG_RESTORE_BIN=
# Accepted by /api/cron/core only when NODE_ENV is not production.
DEV_CRON_SECRET=
# Fixed OTP used only when NODE_ENV is not production.
DEV_OTP_CODE=
# Development/test only. The payments simulator refuses to load in production.
PAYMENTS_SIMULATOR=0
