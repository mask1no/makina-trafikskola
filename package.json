{
  "name": "makina-trafikskola",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "prisma migrate deploy && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "e2e:install": "playwright install chromium",
    "e2e:prepare": "tsx e2e/prepare.ts",
    "test:e2e": "npm run e2e:prepare && npm run build && playwright test",
    "screenshots": "tsx scripts/run-screenshots.ts",
    "check:translations": "tsx scripts/check-translations.ts",
    "i18n:export": "tsx scripts/i18n-export.ts",
    "launch:check": "tsx scripts/launch-check.ts",
    "admin:grant": "tsx scripts/admin-grant.ts",
    "client:check": "tsx scripts/import-client-data.ts",
    "client:apply": "tsx scripts/import-client-data.ts --apply",
    "env:railway:check": "tsx scripts/railway-env.ts --check",
    "env:railway:apply": "tsx scripts/railway-env.ts --apply",
    "theory:import": "tsx scripts/import-theory.ts",
    "test:booking-concurrency": "tsx scripts/booking-concurrency.ts",
    "test:concurrency": "vitest run --config vitest.integration.config.mts src/app/api/bookings/concurrency.integration.test.ts src/app/api/courses/bookings/concurrency.integration.test.ts",
    "test:webhook-replay": "vitest run --config vitest.integration.config.mts src/app/api/webhooks/stripe/replay.integration.test.ts",
    "backup:db": "tsx scripts/backup-db.ts",
    "verify:restore": "tsx scripts/verify-restore.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "glob": "10.5.0",
    "postcss": "$postcss",
    "typescript-eslint": "8.55.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@prisma/client": "6.19.3",
    "@sentry/nextjs": "10.73.0",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@vis.gl/react-google-maps": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "google-auth-library": "^10.9.1",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
